{
  "name": "space42-api-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Resilient, enterprise-grade API automation framework for the restful-booker booking lifecycle. Playwright + TypeScript + Zod + Allure 3.",
  "keywords": [
    "playwright",
    "typescript",
    "api-testing",
    "allure",
    "github-actions",
    "restful-booker"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:core": "playwright test --project=core",
    "test:api": "playwright test --project=core",
    "test:smoke": "playwright test --grep @smoke",
    "test:concurrency": "playwright test --grep @concurrency",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean:allure": "node -e \"const fs=require('node:fs');['allure-results','allure-report'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "allure:generate": "allure generate ./allure-results -o ./allure-report --clean",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-report",
    "ci": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "allure": "^3.21.0",
    "allure-js-commons": "^3.14.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
