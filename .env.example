# ---------------------------------------------------------------------------
# Space42 API Automation - local environment template
#
# Copy to `.env` (git-ignored) and adjust. Every value below is OPTIONAL:
# built-in defaults are `API_MODE=mock`, `API_ENV=sandbox`, `WORKERS=4`.
#
# In CI these values are injected from the workflow inputs / repository
# variables / environment-scoped secrets - never from this file.
# ---------------------------------------------------------------------------

# Where requests are sent: `mock` (in-process enterprise mock) or `real`.
API_MODE=mock

# Named profile: sandbox | uat | prod. Selects the base URL + credential set.
API_ENV=sandbox

# Optional base URL override. Takes precedence over the profile in
# config/environments.ts. Required for `real` + sandbox/uat (left blank here).
# BASE_URL=

# Credentials for the authentication endpoint. The public restful-booker
# sandbox default (admin / password123) is used when these are absent.
# API_USERNAME=
# API_PASSWORD=

# Parallelism. `real` mode is capped by the active profile (see config).
WORKERS=4

# Optional tuning knobs.
# REQUEST_TIMEOUT_MS=15000
# TOKEN_TTL_MS=600000
# LOG_LEVEL=info

# Force-enable the real-sandbox observation specs outside the prod profile.
# RUN_BEHAVIOUR_TESTS=false

# Deterministic mock (API_MODE=mock). Loopback only; not secrets.
# MOCK_PORT=4010
# MOCK_ADMIN_KEY=mock-admin
# MOCK_USERNAME=admin
# MOCK_PASSWORD=password123
# MOCK_VIEWER_USERNAME=viewer
# MOCK_VIEWER_PASSWORD=viewerpass
# MOCK_TOKEN_TTL_MS=900000
