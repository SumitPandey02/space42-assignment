# ---------------------------------------------------------------------------
# Space42 API Automation - local environment template
#
# Copy to `.env` (git-ignored) and adjust. Every value below is OPTIONAL;
# the defaults target the public restful-booker sandbox with 4 workers.
#
# In CI these values are injected from workflow inputs / repository variables /
# environment-scoped secrets - never from this file.
# ---------------------------------------------------------------------------

# Optional base URL override. Defaults to https://restful-booker.herokuapp.com.
# BASE_URL=

# Credentials for the authentication endpoint. The public sandbox default
# (admin / password123) is used when these are absent.
# API_USERNAME=
# API_PASSWORD=

# Parallelism, capped at 4 to stay polite on the shared host.
WORKERS=4

# Optional tuning knobs.
# REQUEST_TIMEOUT_MS=15000
# TOKEN_TTL_MS=600000
# LOG_LEVEL=info
